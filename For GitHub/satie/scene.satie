# Sandglow is a gallery art installation: a real sandbox with: the developer's layout, as fixtures
world Sandglow is a gallery art installation: a real sandbox with
  seed 1
  size 20
  terrain relief 0 roughness 0
  ground sand weight 1
  ground dirt weight 0.5
  ground mud weight 0.5
  ground water weight 0.5
  fixture sandbox sandbox size 1.6x0.15x1 material sand at 0,0
  weather rain 0 wind 0.2 fog 0
  time 10:00 season summer temp 18

level_reference 70
# the place itself: warm, still tidal shore in the mangroves
gen hara_shore
    prompt Persian Gulf mangrove shoreline at low tide, small waves lapping over a wide mudflat, gulls calling now and then and an occasional heron croak, warm still air, no wind, no people, field recording, seamless ambience loop, consistent texture
    duration 30
    loopable

2 * loop hara_shore
    source_id hara_bed
    bed
    zone forest strict
    spl 40
    visual none
    randomstart

# fiddler and mud crabs clicking among the pencil roots
oneshot community/mud-crab-making-short-cluster every 5to12
    source_id hara_crabs
    zone forest strict
    radius 0.6
    at sandbox
    spl 38
    distance_model free_field_v1
    visual sphere

# a heron somewhere in the mangroves
oneshot gen single western reef heron giving a harsh guttural croak, close dry recording every 14to32
    source_id hara_heron_call
    zone forest strict
    place 0 4 18
    move static
    spl 70
    filter lowpass cutoff 1500
    distance_model free_field_v1
    variants 2
    visual sphere

# startled birds lift off the shallows: a burst of wings and a heron's alarm croak
on birds_takeoff gen single western reef heron giving a harsh guttural croak, close dry recording
    source_id hara_alarm
    zone forest strict
    radius 0.3
    at hand
    spl 64
    cooldown 1.2
    distance_model free_field_v1
    variants 2
    visual sphere

on birds_takeoff community/sudden-burst-wings-clapping
    source_id hara_wings
    zone forest strict
    radius 0.2
    at hand
    spl 62
    cooldown 0.5
    distance_model free_field_v1
    visual sphere

# the hand in the sea water
on ripple community/one-playful-hand-splash
    source_id hara_splash
    zone forest strict
    radius 0.15
    at hand
    spl follow hand_speed 0to1 44to56
    cooldown 0.35
    distance_model free_field_v1
    visual sphere

on ripple community/one-restrained-retreat-3
    source_id hara_retreat
    zone forest strict
    radius 0.15
    at hand
    spl follow hand_speed 0to1 40to50
    cooldown 0.6
    distance_model free_field_v1
    visual sphere

# digging opens a channel: water gurgles into the scooped mud
on dig gen single hand scooping wet tidal mud as sea water gurgles in, soft suction and trickling water, close dry recording
    source_id hara_dig
    zone forest strict
    radius 0.15
    at hand
    spl follow hand_speed 0to1 48to60
    cooldown 0.2
    distance_model free_field_v1
    variants 3
    visual sphere

# piling makes mudflat: thick wet mud pushed up, water draining off
on pile gen single hand pushing wet tidal mud into a low bank, thick squelch and water draining off, close dry recording
    source_id hara_pile
    zone forest strict
    radius 0.15
    at hand
    spl follow hand_speed 0to1 47to59
    cooldown 0.2
    distance_model free_field_v1
    variants 3
    visual sphere

